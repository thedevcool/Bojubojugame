ENV=dev
# Neon/Supabase URL in prod (postgres://...); SQLite is fine locally.
DATABASE_URL=sqlite+aiosqlite:///./boju.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_MINUTES=360
# Exact frontend origin(s), comma separated. Strict CORS + WS origin check in prod.
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# Used in password-reset links
PUBLIC_FRONTEND_URL=http://localhost:3000
# Optional password-reset email (leave SMTP_HOST empty to just log the link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Boju Boju <no-reply@yourdomain.com>
# Wall ads: REAL money through Paystack (leave empty and the ad sheet says "coming soon")
PAYSTACK_SECRET_KEY=
# Long random string for the /admin page (approve / reject ads)
ADMIN_TOKEN=
# Local testing only: skip Paystack and treat every ad as paid. NEVER in production.
ADS_FAKE_PAYMENTS=false
# LagosLife mini version (Vatar Games SDK) — see LAGOSLIFE.md. Empty = mini version off.
VATAR_SECRET=
VATAR_WEBHOOK_SECRET=
VATAR_RESULTS_SECRET=
VATAR_API=https://lagoslife.app/api/games/v1
