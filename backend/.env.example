ENV=dev
# Neon/Supabase URL in prod (postgres://...); SQLite is fine locally.
DATABASE_URL=sqlite+aiosqlite:///./boju.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_MINUTES=360
# Exact frontend origin(s), comma separated. Strict CORS + WS origin check in prod.
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
